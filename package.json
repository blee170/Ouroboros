{
  "name": "ouroboros",
  "productName": "Ouroboros",
  "version": "0.2.9",
  "description": "Personal infinite-canvas cockpit for running and conducting multiple Claude Code sessions on Windows",
  "main": "./out/main/index.js",
  "author": "blee170",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && npm run build:mcp",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:win": "node scripts/gen-icon.mjs && npm run build && electron-builder --win --x64",
    "dist:linux": "node scripts/gen-icon.mjs && npm run build && electron-builder --linux --x64",
    "icon": "node scripts/gen-icon.mjs",
    "dist:win:portable": "node scripts/gen-icon.mjs && npm run build && electron-builder --win portable --x64",
    "build:mcp": "vite build -c vite.mcp.config.mts && vite build -c vite.mcp.config.mts --mode agent-hook"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "electron-updater": "^6.8.9",
    "nanoid": "^6.0.2",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
